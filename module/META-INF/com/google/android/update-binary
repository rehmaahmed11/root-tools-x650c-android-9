#!/sbin/sh
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() { echo "$1"; }
if [ ! -f /data/adb/magisk/util_functions.sh ]; then
  ui_print "Magisk is required. Install this ZIP from the Magisk app."
  exit 1
fi
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -ge 24000 ] || { ui_print "Magisk 24+ required."; exit 1; }
install_module
exit 0
